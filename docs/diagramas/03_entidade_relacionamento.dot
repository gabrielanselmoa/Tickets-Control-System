digraph G {graph [fontname="DejaVu Sans",pad="0.3",bgcolor="white",ranksep="0.9"];node [fontname="DejaVu Sans",shape=box,style="rounded,filled",fillcolor="#F0F7F7",color="#237C77",margin="0.18,0.12"];edge [fontname="DejaVu Sans",color="#506273"];rankdir=LR;node [shape=record,style=filled];d [label="{departments|PK id INTEGER\lname TEXT UNIQUE\lprefix TEXT UNIQUE\lactive INTEGER\lcreated_at TEXT\l}"] ;p [label="{service_points|PK id INTEGER\lname TEXT UNIQUE\lactive INTEGER\l}"] ;t [label="{tickets|PK id INTEGER\lcode TEXT UNIQUE\lFK department_id INTEGER\lFK service_point_id INTEGER NULL\lcustomer_name TEXT\ldescription TEXT\lpriority TEXT\lstatus TEXT\lcreated_at TEXT\lupdated_at TEXT\l}"] ;e [label="{ticket_events|PK id INTEGER\lFK ticket_id INTEGER\lold_status TEXT\lnew_status TEXT\lnote TEXT\lcreated_at TEXT\l}"] ;d -> t [label="1:N",arrowhead=crow];p -> t [label="0..1:N",arrowhead=crow];t -> e [label="1:N",arrowhead=crow];}