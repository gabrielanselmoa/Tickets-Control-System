digraph G {graph [fontname="DejaVu Sans",pad="0.3",bgcolor="white",ranksep="0.9"];node [fontname="DejaVu Sans",shape=box,style="rounded,filled",fillcolor="#F0F7F7",color="#237C77",margin="0.18,0.12"];edge [fontname="DejaVu Sans",color="#506273"];rankdir=LR;node [shape=record,style=filled];Department [label="{Departamento|id: int\lname: str\lprefix: str\lactive: bool\l|criar()\latualizar()\lexcluir()\l}"] ; Point [label="{Guiche|id: int\lname: str\lactive: bool\l|criar()\latualizar()\lexcluir()\l}"] ; Ticket [label="{Ticket|id: int\lcode: str\lcustomer_name: str\ldescription: str\lpriority: str\lstatus: str\lcreated_at: datetime\lupdated_at: datetime\l|criar()\lconsultar()\latualizar()\lexcluir()\lmudarStatus()\l}"] ; Event [label="{EventoTicket|id: int\lold_status: str\lnew_status: str\lnote: str\lcreated_at: datetime\l}"] ; Department -> Ticket [label="1 para N",arrowhead=none];Point -> Ticket [label="0..1 para N",arrowhead=none];Ticket -> Event [label="1 para N",arrowhead=none];}