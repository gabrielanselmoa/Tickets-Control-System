digraph G {graph [fontname="DejaVu Sans",pad="0.3",bgcolor="white",ranksep="0.9"];node [fontname="DejaVu Sans",shape=box,style="rounded,filled",fillcolor="#F0F7F7",color="#237C77",margin="0.18,0.12"];edge [fontname="DejaVu Sans",color="#506273"];rankdir=TB;node [shape=box];start [label="Início",shape=oval];form [label="Preencher formulário de ticket"];validate [label="Dados válidos?",shape=diamond,fillcolor="#FFF3DF"];error [label="Exibir mensagem de validação"];create [label="Persistir ticket WAITING"];wait [label="Aguardando atendimento"];call [label="Chamar em guichê (CALLED)"];serve [label="Iniciar atendimento (IN_SERVICE)"];finish [label="Finalizar (FINISHED)"];end [label="Fim",shape=oval];start->form->validate;validate->error [label="Não"];error->form;validate->create [label="Sim"];create->wait->call->serve->finish->end;wait->end [label="Cancelar",style=dashed];}